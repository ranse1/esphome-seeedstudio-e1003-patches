+// Integer Rec.709 luma. Same weights as `0.2125*r + 0.7154*g + 0.0721*b` scaled
+// by 256 (54 + 183 + 19 = 256 exactly), so this is three integer multiplies
+// instead of three soft-float doubles - Xtensa has no hardware double and this
+// runs once for every pixel of every decoded image. For grey input
+// (r == g == b == v) it returns exactly v, where the float version could
+// truncate to v-1 because the weights do not sum to exactly 1.0 in binary.
+inline uint8_t luma(const Color &color) {
+  return static_cast<uint8_t>((54u * color.r + 183u * color.g + 19u * color.b + 128u) >> 8);
+}
