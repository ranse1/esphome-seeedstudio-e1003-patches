   IMAGE_TYPE_GRAYSCALE = 1,
   IMAGE_TYPE_RGB = 2,
   IMAGE_TYPE_RGB565 = 3,
+  // 4 bits per pixel, two pixels per byte, high nibble first - the same packing
+  // and order as IMAGE_TYPE_BINARY uses for its bits. Rows are padded to a byte
+  // boundary, so get_width_stride() already returns the right value.
+  //
+  // Halves the buffer against IMAGE_TYPE_GRAYSCALE, which matters for
+  // full-screen online_image buffers in PSRAM, and is the native format of
+  // 16-level e-paper controllers such as the IT8951.
+  IMAGE_TYPE_GRAYSCALE_4BIT = 4,
 };
 
+/// Expand a 4-bit grey level to 8-bit. The 16 levels are n * 255/15 = n * 17,
+/// so level 15 becomes a true 255 and every level survives a round trip.
+inline uint8_t gray4_to_gray8(uint8_t nibble) { return static_cast<uint8_t>(nibble * 17u); }
+
+/// The inverse: a rounding divide by 17 with no division instruction, since
+/// 4096 / 17 = 240.94. Exact for all 256 inputs and never exceeds 15, so
+/// callers need no clamp.
+inline uint8_t gray8_to_gray4(uint8_t gray) { return static_cast<uint8_t>((gray * 241u + 2048u) >> 12); }
