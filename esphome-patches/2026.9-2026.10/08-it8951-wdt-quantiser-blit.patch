+bool HOT IT8951Display::draw_gray4_packed(int x_start, int y_start, int w, int h, const uint8_t *src,
+                                          size_t src_stride) {
+  // Every condition below is a reason the row-wise shortcut cannot be trusted;
+  // returning false simply sends the caller back to the per-pixel path.
+  if (this->buffer_ == nullptr || src == nullptr)
+    return false;
+  if (!this->grayscale_)
+    return false;  // monochrome framebuffer packs 8 pixels per byte, not 2
+  if (this->invert_colors_)
+    return false;  // a byte copy would skip the 0x0F - n flip write_pixel_native_ applies
+  if (this->get_clipping().is_set())
+    return false;  // would need a per-pixel test
+  if (this->effective_transform_ & TRANSFORM_SWAP_XY)
+    return false;  // a source row is not a destination row
+  // Byte alignment: a source row is two pixels per byte, so the destination
+  // run must start on an even x and be an even number of pixels wide, or it
+  // would straddle nibbles and need shifting. With mirror_x the run starts at
+  // W - x_start - w, which is even exactly when W, x_start and w all are. The
+  // 240x246 tile overlays and the full page image all qualify; anything else
+  // takes the pixel path, which is correct for every alignment.
+  if (w <= 0 || h <= 0 || (x_start & 1) != 0 || (w & 1) != 0)
+    return false;
+  if (x_start < 0 || y_start < 0 || x_start + w > this->width_ || y_start + h > this->height_)
+    return false;
+  const bool mirror_x = (this->effective_transform_ & TRANSFORM_MIRROR_X) != 0;
+  const bool mirror_y = (this->effective_transform_ & TRANSFORM_MIRROR_Y) != 0;
+  if (mirror_x && (this->width_ & 1) != 0)
+    return false;
+
+  const size_t row_bytes = static_cast<size_t>(this->row_width_);
+  const size_t run_bytes = static_cast<size_t>(w) >> 1;
+  if (src_stride != run_bytes)
+    return false;
+
+  // Destination x of the run's first byte, in native framebuffer coordinates.
+  const int dst_x0 = mirror_x ? (this->width_ - x_start - w) : x_start;
+  const size_t dst_byte0 = static_cast<size_t>(dst_x0) >> 1;
+
+  for (int y = 0; y < h; y++) {
+    if ((y & 63) == 0)
+      App.feed_wdt();
+    const uint8_t *s = src + static_cast<size_t>(y) * src_stride;
+    const int dst_y = mirror_y ? (this->height_ - 1 - (y_start + y)) : (y_start + y);
+    uint8_t *d = this->buffer_ + static_cast<size_t>(dst_y) * row_bytes + dst_byte0;
+
+    if (!mirror_x) {
+      memcpy(d, s, run_bytes);
+      continue;
+    }
+
+    // Mirroring an even-width 4bpp run is a byte reversal plus a nibble swap.
+    //
+    // Source byte i holds x = 2i in the high nibble and x = 2i+1 in the low.
+    // With an even run start and even W, mirroring flips the parity of every x:
+    //   x = 2i    -> odd  -> LOW  nibble of run byte w/2-1-i
+    //   x = 2i+1  -> even -> HIGH nibble of run byte w/2-1-i
+    // Both land in the same destination byte, with their nibbles exchanged.
+    //
+    // Four bytes at a time when both ends are word aligned (every full page
+    // row and every even-x overlay used here is): byte-reverse the word, then
+    // swap nibbles in all four bytes at once. Xtensa faults on unaligned word
+    // access, so the byte loop stays as the fallback.
+    const uint8_t *sp = s;
+    uint8_t *dp = d + run_bytes - 1;
+    size_t i = 0;
+    if (((reinterpret_cast<uintptr_t>(s) | reinterpret_cast<uintptr_t>(d) | run_bytes) & 3u) == 0) {
+      const uint32_t *sw = reinterpret_cast<const uint32_t *>(s);
+      uint32_t *dw = reinterpret_cast<uint32_t *>(d + run_bytes - 4);
+      for (; i < run_bytes; i += 4, sw++, dw--) {
+        uint32_t v = __builtin_bswap32(*sw);
+        *dw = ((v & 0x0F0F0F0Fu) << 4) | ((v >> 4) & 0x0F0F0F0Fu);
+      }
+    }
+    for (sp += i, dp -= i; i < run_bytes; i++, sp++, dp--) {
+      const uint8_t b = *sp;
+      *dp = static_cast<uint8_t>((b << 4) | (b >> 4));
+    }
+  }
+
+  // Grow the dirty box by the blitted region, in native coordinates.
+  const int dst_y0 = mirror_y ? (this->height_ - y_start - h) : y_start;
+  this->x_low_ = clamp_at_most(this->x_low_, static_cast<uint16_t>(dst_x0));
+  this->x_high_ = clamp_at_least(this->x_high_, static_cast<uint16_t>(dst_x0 + w));
+  this->y_low_ = clamp_at_most(this->y_low_, static_cast<uint16_t>(dst_y0));
+  this->y_high_ = clamp_at_least(this->y_high_, static_cast<uint16_t>(dst_y0 + h));
+  return true;
+}
