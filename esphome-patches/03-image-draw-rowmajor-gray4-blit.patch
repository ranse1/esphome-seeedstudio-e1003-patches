+Color Image::get_grayscale_4bit_pixel_(int x, int y) const {
+  // Two pixels per byte, high nibble first, rows padded to a byte boundary.
+  const uint8_t packed = progmem_read_byte(this->data_start_ + y * this->get_width_stride() + (x >> 1));
+  const uint8_t nibble = (x & 1) ? (packed & 0x0F) : (packed >> 4);
+  const uint8_t gray = gray4_to_gray8(nibble);
+  switch (this->transparency_) {
+    case TRANSPARENCY_CHROMA_KEY:
+      // Mirrors the 8-bit case: one level is reserved as the key. There it is
+      // value 1; here it is level 1.
+      if (nibble == 1)
+        return Color(0, 0, 0, 0);
+      return Color(gray, gray, gray, 0xFF);
+    case TRANSPARENCY_ALPHA_CHANNEL:
+      return Color(0, 0, 0, gray);
+    default:
+      return Color(gray, gray, gray, 0xFF);
+  }
+}
