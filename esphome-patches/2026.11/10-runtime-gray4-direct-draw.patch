+// The opaque case of RuntimeImage::draw_pixel() for GRAYSCALE_4BIT, minus its per-pixel call, checks and type switch:
+// it runs for every pixel of a full-screen PNG. color_to_gray4() and set_gray4() keep the two byte-identical.
+void ImageDecoder::draw_gray4_(int x, int y, int w, int h, const Color &color) {
+  const int x_end = std::min(x + w, this->draw_width_);
+  const int y_end = std::min(y + h, this->draw_height_);
+  x = std::max(x, 0);
+  y = std::max(y, 0);
+  const uint8_t nibble = image::color_to_gray4(color);
+  const size_t stride = (static_cast<size_t>(this->draw_width_) + 1u) / 2u;
+  uint8_t *const buffer = this->image_buffer_();
+  for (int row = y; row < y_end; row++) {
+    uint8_t *line = buffer + static_cast<size_t>(row) * stride;
+    for (int col = x; col < x_end; col++)
+      image::set_gray4(line, col, nibble);
+  }
+}
