+/// Expand a 4-bit grey level to 8-bit. The 16 levels are n * 255/15 = n * 17,
+/// so level 15 becomes a true 255 and every level survives a round trip.
+inline uint8_t gray4_to_gray8(uint8_t nibble) { return static_cast<uint8_t>(nibble * 17u); }
+
+/// The inverse: a rounding divide by 17 with no division instruction, since
+/// 4096 / 17 = 240.94. Exact for all 256 inputs and never exceeds 15, so
+/// callers need no clamp.
+inline uint8_t gray8_to_gray4(uint8_t gray) { return static_cast<uint8_t>((gray * 241u + 2048u) >> 12); }
+
+/// A colour's 4-bit grey level, from the same integer luma as RuntimeImage's 8-bit case. The one definition for
+/// every 4bpp decode path, which must agree byte for byte; it runs per decoded pixel, so no float here.
+inline uint8_t color_to_gray4(const Color &color) {
+  return gray8_to_gray4(static_cast<uint8_t>((54 * color.r + 183 * color.g + 19 * color.b) >> 8));
+}
+
+/// Store a 4-bit level as pixel x of a packed row, high nibble first as BINARY is MSB first. Read-modify-write: the
+/// byte is shared with the neighbouring pixel.
+inline void set_gray4(uint8_t *row, int x, uint8_t nibble) {
+  uint8_t &byte = row[x >> 1];
+  byte = (x & 1) ? static_cast<uint8_t>((byte & 0xF0u) | nibble) : static_cast<uint8_t>((byte & 0x0Fu) | (nibble << 4));
+}
