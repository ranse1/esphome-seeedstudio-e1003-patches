   IMAGE_TYPE_RGB111 = 4,  // one bit per channel plus an optional alpha bit, for colour e-paper
+  // 4 bits per pixel, two pixels per byte, high nibble first - the same packing
+  // and order as IMAGE_TYPE_BINARY uses for its bits. Rows are padded to a byte
