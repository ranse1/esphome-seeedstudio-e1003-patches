+def _image_platform(image_id) -> str | None:
+    for conf in CORE.config.get("image", []):
+        if str(conf.get(CONF_ID)) == str(image_id):
+            return conf.get(CONF_PLATFORM)
+    return None
+
+
+async def _preload_to_code(var, preload: ConfigType, width: int, height: int) -> None:
+    pages = []
+    for page, key in enumerate((CONF_HOME, CONF_NEXT), start=1):
+        if key not in preload:
+            pages.append(cg.nullptr)
+            continue
+        image_id = preload[key]
+        img = await cg.get_variable(image_id)
+        # Image metadata exists only once the image's own codegen ran, so this
+        # check cannot live in the config validation. An online_image without
+        # `resize:` reports 0x0: its size is only known after a download.
+        meta = image.get_image_metadata(str(image_id))
+        size_known = meta is not None and meta.width and meta.height
+        if meta is not None and (
+            (size_known and (meta.width != width or meta.height != height))
+            or str(meta.image_type).upper() != "GRAYSCALE_4BIT"
+            or str(meta.transparency).lower() != "opaque"
+        ):
+            raise core.EsphomeError(
+                f"preload {key}: '{image_id}' must be an opaque GRAYSCALE_4BIT image of "
+                f"exactly {width}x{height}, the panel's size; it is {meta.width}x{meta.height}, "
+                f"{meta.image_type}, {meta.transparency}"
+            )
+        pages.append(img)
+        # A download decodes into the same buffer: the driver must hear of it
+        # before the first byte is written, and again once the image is whole.
+        if _image_platform(image_id) == "online_image":
+            for hook, args in (
+                ("add_on_download_started_callback", ""),
+                ("add_on_finished_callback", "bool"),
+                ("add_on_error_callback", ""),
+            ):
+                call = "changing" if hook == "add_on_download_started_callback" else "changed"
+                cg.add(RawExpression(f"{img}->{hook}([]({args}) {{ {var}->preload_page_{call}({page}); }})"))
+    cg.add(var.set_preload_pages(*pages))
+
 
