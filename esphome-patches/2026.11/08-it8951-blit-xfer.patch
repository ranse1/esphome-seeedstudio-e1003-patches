+    if (r.w == this->width_ && r.h == this->height_) {
+      this->invalidate_preload_();
+      return;
+    }
+    this->set_blocks_(this->stale_, r.x, r.y, r.x2(), r.y2(), 1);
+  }
+}
+
+void IT8951Display::account_preload_(const Rect &r) {
+  const int loaded = r.y + this->transfer_row_;
+  const int whole = loaded >= this->height_ ? this->height_ : loaded / BLOCK_H * BLOCK_H;
+  this->set_blocks_(this->stale_, 0, this->preload_row_, this->width_, whole, 0);
+  this->preload_row_ = whole;
+}
+
+void IT8951Display::invalidate_preload_() {
+  this->preload_row_ = 0;
+  this->preload_restarted_ = true;
+  this->set_blocks_(this->stale_, 0, 0, this->width_, this->height_, 1);
+}
+
+bool IT8951Display::preload_wanted_() const {
+  return this->initialised_ && this->preload_src_ != nullptr && this->preload_row_ < this->height_;
+}
+
+void IT8951Display::start_preload_() {
+  // The Preload line times from here; the update has logged.
+  this->update_started_at_ = millis();
+  this->set_phase_(Phase::PRELOAD_WAIT);
+  this->enqueue_wake_();
+  // Nothing says the LUT engine is done with controller RAM before its
+  // waveform ends, so the load waits for that. It is background work anyway.
+  this->enqueue_lut_idle_poll_();
+}
+
+// On first use only, so a display that never preloads keeps its memory and
+// loads every update's whole area one row at a time, as before.
+bool IT8951Display::allocate_preload_() {
+  if (this->stage_ != nullptr)
+    return true;
+  this->block_cols_ = static_cast<uint16_t>((this->width_ + BLOCK_W - 1) / BLOCK_W);
+  this->block_rows_ = static_cast<uint16_t>((this->height_ + BLOCK_H - 1) / BLOCK_H);
+  RAMAllocator<uint8_t> allocator{};
+  uint8_t *maps = allocator.allocate(2 * this->block_count_());
+  // Internal RAM: the CPU fills it and the DMA reads it with no PSRAM round trip.
+  RAMAllocator<uint8_t> internal(RAMAllocator<uint8_t>::ALLOC_INTERNAL);
+  uint8_t *stage = internal.allocate(XFER_BATCH_BYTES);
+  if (maps == nullptr || stage == nullptr) {
+    ESP_LOGW(TAG, "No memory for the preload buffers; preload off");
+    if (maps != nullptr)
+      allocator.deallocate(maps, 2 * this->block_count_());
+    if (stage != nullptr)
+      internal.deallocate(stage, XFER_BATCH_BYTES);
+    return false;
+  }
+  this->drawn_ = maps;
+  this->stale_ = maps + this->block_count_();
+  this->stage_ = stage;
+  return true;
+}
+
+void IT8951Display::set_preload_enabled(bool enabled) {
+  this->preload_enabled_ = enabled;
+  if (!enabled) {
+    this->set_preload_source(nullptr, 0, 0);
+    return;
+  }
+#ifdef USE_IMAGE
+  this->select_preload_page_();
+#endif
+}
+
+#ifdef USE_IMAGE
+void IT8951Display::select_preload_page_() {
+  if (this->preload_pages_[0] == nullptr)
+    return;  // no `preload:` in YAML; the lambda calls decide
+  const uint8_t index = this->home_shown_ ? 1 : 0;
+  const image::Image *page = this->preload_pages_[index];
+  if (page == nullptr || this->preload_page_busy_[index] || page->get_data_start() == nullptr) {
+    this->set_preload_source(nullptr, 0, 0);
+    return;
+  }
+  this->set_preload_source(page->get_data_start(), page->get_width_stride(), index + 1);
+}
+
+void IT8951Display::preload_page_changing(uint8_t page) {
+  this->preload_page_busy_[page - 1] = true;
+  this->drop_preload_source(page);
+}
+
+void IT8951Display::preload_page_changed(uint8_t page) {
+  this->preload_page_busy_[page - 1] = false;
+  this->preload_reselect_ = true;
+  this->enable_loop();
+}
+#endif
+
+void IT8951Display::set_preload_source(const uint8_t *src, size_t stride, uint8_t tag) {
+  // The preload reproduces what draw_gray4_packed() writes for a full panel.
+  const bool usable = src != nullptr && this->preload_enabled_ && this->buffer_ != nullptr &&
+                      this->packed_rows_ok_() && stride >= this->row_width_ && this->allocate_preload_();
+  // Same source again: nothing to redo, since a new decode drops it first.
+  if (usable && src == this->preload_src_ && stride == this->preload_stride_ && tag == this->preload_tag_)
+    return;
+  this->preload_src_ = usable ? src : nullptr;
+  this->preload_stride_ = stride;
+  this->preload_tag_ = usable ? tag : 0;
+  this->invalidate_preload_();
+  if (usable && this->phase_ == Phase::IDLE)
+    this->enable_loop();
 }
 
