+// Whether 4bpp source rows go into the framebuffer as plain bytes. The blit
+// and the preload both rely on it, and must agree byte for byte.
+bool IT8951Display::packed_rows_ok_() const {
+  if (!this->grayscale_)
+    return false;  // monochrome framebuffer packs 8 pixels per byte, not 2
+  if (this->invert_colors_)
+    return false;  // a byte copy would skip the 0x0F - n flip write_pixel_native_ applies
+  if (this->effective_transform_ & TRANSFORM_SWAP_XY)
+    return false;  // a source row is not a destination row
+  // Mirroring keeps a run byte-aligned only with an even W (draw_gray4_packed).
+  return !(this->effective_transform_ & TRANSFORM_MIRROR_X) || (this->width_ & 1) == 0;
+}
