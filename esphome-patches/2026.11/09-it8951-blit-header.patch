+  // YAML `preload:` (display.py). The driver then picks the source itself,
+  // from which page it last drew whole: `next` while `home` is shown, `home`
+  // otherwise. Either may be nullptr.
+  void set_preload_pages(image::Image *home, image::Image *next) {
+    this->preload_pages_[0] = home;
+    this->preload_pages_[1] = next;
+  }
+  // From the online_image hooks display.py generates; page 1 is home, 2 next.
+  // A page between the two is never preloaded: its decode writes in place.
+  void preload_page_changing(uint8_t page);
