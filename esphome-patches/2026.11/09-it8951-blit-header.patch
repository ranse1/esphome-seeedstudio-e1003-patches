+  // Preload: a full-panel 4bpp image, in the layout draw_gray4_packed() takes,
+  // that the driver streams into the controller's RAM whenever it is idle,
+  // without displaying it. A later full-panel blit of the same source then
+  // only has to send what changed since and what is drawn over it. Setting
+  // the same source again is a no-op, so drop it before its content changes
+  // (a re-decode writes in place) and set it again after. `tag` is any
+  // caller-chosen id, for drop_preload_source(). Never called, nothing is
+  // allocated and every update transfers as it did without the preload.
+  void set_preload_source(const uint8_t *src, size_t stride, uint8_t tag);
+  void drop_preload_source(uint8_t tag) {
+    if (this->preload_tag_ == tag)
+      this->set_preload_source(nullptr, 0, 0);
+  }
+  void set_preload_enabled(bool enabled);
